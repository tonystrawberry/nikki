# Required for the /chat ("digital clone") feature.
# Create a key at https://console.anthropic.com/ and paste it here, then copy
# this file to .env.local (which is gitignored).
ANTHROPIC_API_KEY=sk-ant-...

# Required only to (re)build the blog RAG index: `npm run embeddings`.
# Create a key at https://dashboard.voyageai.com/. The generated index is
# committed, so deploys/serving do NOT need this key.
VOYAGE_API_KEY=pa-...
# Optional: override the embedding model (default: voyage-3.5).
# VOYAGE_MODEL=voyage-3.5

# Realtime chat WebSocket server
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:3100/cable
NEXT_PUBLIC_CHAT_HTTP_URL=http://localhost:3100

# VAPID public key (must match chat-server's VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
